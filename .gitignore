# Open-source export policy: track everything unless explicitly excluded below.
# Source code, runnable configuration, PDDL domains, the root README, and
# dependency manifests are tracked; generated data, weights, and caches are not.

# Local secrets, editor state, and caches
.env
.env.*
.codex/
.idea/
.vscode/
.DS_Store
*.swp
*.swo
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Runtime outputs, generated artifacts, and experiment data
# (data/replan_prediction keeps the replan-prediction evidence JSONs)
data/*
!data/replan_prediction/
workflow_decouple/data/
plot/figures/
plot/*.csv
plot/*.json
revision_eval/results/
revision_eval/plots/
ns3_comm_sim/inputs/
ns3_comm_sim/results/
ns3_comm_sim/plots/
src/tools/logs/
logs/
runtime/
tmp/
temp/
.tmp/
*.log
*.out
*.err
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Papers, review artifacts, demos, and generated documentation
R1_response/
paper_latex/
loge_viz/
loge_visualization_api_docs/
old_interfaces/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.run.xml
*.synctex.gz
*.toc
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.md
!/README.md

# Model weights, model caches, learned adapters, and prediction artifacts
model_cache/
**/model_cache/
**/lora_model/
**/lora_model_dr/
revision_eval/
config/advanced_logging_config.yaml
config/*agents_config.yaml
workflow_decouple/config/*rules.yaml
src/plots/
workflow_decouple/src/plot/
plot/export_figure_tables.py
plot/plot_figures.py
plot/plot_events.py
plot/plot_lora.py
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.pkl
*.joblib
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.avi

# Excluded internal paths
src/offline_pipeline/stage3_plan_*_e2e.py
src/simulation/examples/scalability_prompts.py
workflow_decouple/*can_learn_rules/
workflow_decouple/src/*_rules/
workflow_decouple/src/plot/plot_*_vs_baseline.py
src/baselines/*mock*.py
src/baselines/simulated_*_dp.py
src/simulation/components/*mock*.py
src/simulation/environment/test_speed_monitor.py

# Reference drops, archives, and local third-party installs
ref_code/
ref_code.zip
ns3_install/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
